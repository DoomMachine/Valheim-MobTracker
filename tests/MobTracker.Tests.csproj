<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the parts of MobTracker that need no game objects - the star filters, their cfg text and the Alerts: row's
    settling (StarFilter.cs); the search, watchlist, spacing, spawn-rule, alert-gate, re-track, dungeon-side,
    row-refresh, pointer and key rules (Rules.cs); and MobTracker.log's rules and the text of every line it and
    VerboseLog write (LogRules.cs, EventLines.cs) - compiled from the real source files.
    Run with "dotnet run" from this folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MobTracker.Tests</AssemblyName>
    <RootNamespace>MobTracker</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\build\tests\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestMain.cs" />
    <Compile Include="LogTests.cs" />
    <Compile Include="..\StarFilter.cs" />
    <Compile Include="..\Rules.cs" />
    <Compile Include="..\LogRules.cs" />
    <Compile Include="..\EventLines.cs" />
  </ItemGroup>

</Project>
